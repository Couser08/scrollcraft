{
  "name": "@scrollcraft/core",
  "version": "0.1.1",
  "description": "Headless high-performance game-dev scroll & physics engine for web",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('dist', { recursive: true, force: true });\"",
    "prebuild": "pnpm run clean",
    "build": "tsc",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "lenis": "^1.3.26"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
